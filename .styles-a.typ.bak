#import "@preview/touying:0.7.4": *
#import themes.metropolis: *

// Setup Company A's Brandbook constraints
#show: metropolis-theme.with(
  aspect-ratio: "16-9",
  config-info(
    title: [$if(title)$$title$$endif$],
    subtitle: [$if(subtitle)$$subtitle$$endif$],
    author: [$if(author)$$author$$endif$],
    date: [$if(date)$$date$$endif$],
  ),
  config-colors(
    // Inject custom colors from Markdown frontmatter, or fallback to default
    // NB: '#' is a literal here; store brand-color WITHOUT '#' (e.g. FF5500),
    // because Pandoc escapes '#' in metadata values (-> '\#') which breaks rgb().
    primary: rgb("#$if(brand-color)$$brand-color$$else$0B3A5A$endif$"),
  ),
)

// Set custom typography (e.g., Company A's font)
#set text(font: "Segoe UI", size: 20pt)

// Generate the title slide automatically
#title-slide()

// Render the Markdown body converted by Pandoc
$body$
